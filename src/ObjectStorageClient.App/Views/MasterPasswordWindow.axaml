<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ObjectStorageClient.App.ViewModels"
        x:Class="ObjectStorageClient.App.Views.MasterPasswordWindow"
        x:DataType="vm:MasterPasswordViewModel"
        Title="{Binding Title}"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

  <StackPanel Margin="24" Spacing="12">

    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Opacity="0.85" />

    <!-- Non-ASCII filtering is attached in code-behind: it has to run at the tunnel stage. -->
    <TextBox x:Name="PasswordBox"
             Watermark="Master password"
             PasswordChar="•"
             Text="{Binding Password, Mode=TwoWay}"
             InputMethod.IsInputMethodEnabled="False"
             KeyDown="OnPasswordKeyDown" />

    <TextBox x:Name="ConfirmPasswordBox"
             Watermark="Confirm master password"
             PasswordChar="•"
             IsVisible="{Binding IsCreating}"
             Text="{Binding ConfirmPassword, Mode=TwoWay}"
             InputMethod.IsInputMethodEnabled="False"
             KeyDown="OnPasswordKeyDown" />

    <TextBlock Text="{Binding ErrorMessage}"
               Foreground="#C42B1C"
               TextWrapping="Wrap"
               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <TextBlock Classes="hint"
               Text="{Binding ConfigDirectory, StringFormat='Settings and saved sites: {0}'}" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <ProgressBar IsIndeterminate="True" Width="80" Height="4"
                   VerticalAlignment="Center"
                   IsVisible="{Binding IsBusy}" />

      <!-- Only offered after a failed unlock, so a forgotten password is not a dead end. -->
      <Button Content="Forgot password…"
              IsVisible="{Binding CanReset}"
              Command="{Binding ResetVaultCommand}" />

      <Button Content="Quit" IsCancel="True" Command="{Binding CancelCommand}" />
      <Button Content="{Binding AcceptText}"
              Classes="accent"
              IsDefault="True"
              IsEnabled="{Binding !IsBusy}"
              Command="{Binding SubmitCommand}" />
    </StackPanel>
  </StackPanel>

</Window>
