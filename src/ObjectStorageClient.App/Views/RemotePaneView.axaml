<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ObjectStorageClient.App.ViewModels"
             xmlns:models="using:ObjectStorageClient.Core.Models"
             xmlns:conv="using:ObjectStorageClient.App.Converters"
             x:Class="ObjectStorageClient.App.Views.RemotePaneView"
             x:DataType="vm:RemoteBrowserViewModel">

  <UserControl.Resources>
    <conv:ByteSizeConverter x:Key="ByteSize" />
  </UserControl.Resources>

  <Border Classes="pane">
    <Grid RowDefinitions="Auto,Auto,*,Auto">

      <TextBlock Grid.Row="0" Classes="paneHeader" Text="Remote site" />

      <!-- Bucket selector plus the editable prefix ("remote path"). -->
      <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" Margin="6,0,6,6" ColumnSpacing="4">
        <ComboBox Grid.Column="0"
                  Width="150"
                  ItemsSource="{Binding Buckets}"
                  SelectedItem="{Binding SelectedBucket, Mode=TwoWay}"
                  PlaceholderText="Bucket">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="models:StorageBucket">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBox Grid.Column="1"
                 Text="{Binding CurrentPrefix, Mode=TwoWay}"
                 Watermark="/"
                 KeyDown="OnPrefixKeyDown"
                 ToolTip.Tip="Type a prefix and press Enter" />

        <Button Grid.Column="2" Content="↑" ToolTip.Tip="Parent prefix"
                Command="{Binding NavigateUpCommand}" />
        <Button Grid.Column="3" Content="⟳" ToolTip.Tip="Refresh"
                Command="{Binding RefreshCommand}" />
      </Grid>

      <Panel Grid.Row="2">
        <DataGrid x:Name="EntryGrid"
                  ItemsSource="{Binding Entries}"
                  SelectionChanged="OnSelectionChanged"
                  DoubleTapped="OnDoubleTapped">
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Download" Command="{Binding DownloadCommand}" />
              <Separator />
              <MenuItem Header="Create directory…" Command="{Binding CreateFolderCommand}" />
              <MenuItem Header="Delete" Command="{Binding DeleteSelectedCommand}" />
              <Separator />
              <MenuItem Header="Refresh" Command="{Binding RefreshCommand}" />
            </ContextMenu>
          </DataGrid.ContextMenu>

          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Filename" Width="2*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="models:RemoteEntry">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="4,0">
                    <TextBlock Text="{Binding IsFolder, Converter={x:Static conv:GlyphConverters.RemoteGlyph}}" />
                    <TextBlock Text="{Binding Name}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="Size" Width="90"
                                Binding="{Binding Size, Converter={StaticResource ByteSize}}" />
            <DataGridTextColumn Header="Modified" Width="150"
                                Binding="{Binding LastModified, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
            <DataGridTextColumn Header="Class" Width="100" Binding="{Binding StorageClass}" />
          </DataGrid.Columns>
        </DataGrid>

        <!-- Overlay rather than a swap, so the listing stays visible while it refreshes. -->
        <Border IsVisible="{Binding IsBusy}"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                Opacity="0.6">
          <ProgressBar IsIndeterminate="True" Width="180" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Border>
      </Panel>

      <TextBlock Grid.Row="3" Margin="6,4" Classes="hint" Text="{Binding StatusText}" />
    </Grid>
  </Border>

</UserControl>
